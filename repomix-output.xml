.checklist-toolbar{display:flex;justify-content:space-between;gap:12px;margin-bottom:16px}.checklist-search{display:flex;align-items:center;gap:9px;flex:1;max-width:460px;border:1px solid #dbe2ec;border-radius:9px;padding:0 12px;color:#94a3b8}.checklist-search input{width:100%;min-width:0;border:0;outline:0;min-height:40px;font:inherit;font-size:13px;background:transparent}
